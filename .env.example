# Upstash Redis (dev database locally; prod values live only in Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret salt for hashing visitor IPs in rate-limit keys (any long random string).
# Required in production (VERCEL_ENV=production): the app refuses to fall back to "dev-salt" there.
RL_SALT=

# Namespace for every Redis key: prod | preview | dev. Lets Production and Preview share one Upstash database.
# Required in production and must be "prod" there; defaults to "dev" locally.
REDIS_KEY_PREFIX=

# Optional: GitHub token (no scopes needed) to raise the public API limit for the Dashboard theme
GITHUB_TOKEN=

# Canonical site URL for metadata/sitemap/OG (falls back to Vercel's production domain, then localhost)
NEXT_PUBLIC_SITE_URL=   # full URL incl. https://, e.g. https://example.dev

# Optional: email contact-form messages via Resend (without it they are only logged and stored)
RESEND_API_KEY=
# Optional sender (must be a domain verified in Resend); defaults to Resend's onboarding@resend.dev
RESEND_FROM=

# Feature flags (build time; "on" to enable). Off by default: the site shows only what is ready.
# Case studies and the live lab (LEARNING-164)
NEXT_PUBLIC_FEATURE_CASE_STUDIES=
NEXT_PUBLIC_FEATURE_LAB=
# All 13 themes and the theme switcher; off = Night terminal only (LEARNING-184)
NEXT_PUBLIC_FEATURE_THEMES=
# Work with me section, nav link and hero CTA (round 4)
NEXT_PUBLIC_FEATURE_WORK_WITH_ME=
