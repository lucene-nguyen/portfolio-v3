# Upstash Redis (dev database locally; prod values live only in Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret salt for hashing visitor IPs in rate-limit keys (any random string)
RL_SALT=

# Optional: GitHub token (no scopes needed) to raise the public API limit for the Dashboard theme
GITHUB_TOKEN=
